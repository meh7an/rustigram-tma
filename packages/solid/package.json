{
  "name": "@rustigram/tma-solid",
  "version": "0.0.0",
  "description": "Solid.js reactive bindings and components for Telegram Mini Apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config ./vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rustigram/tma-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@solidjs/testing-library": "^0.8.10",
    "babel-preset-solid": "^1.9.12",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.10.2",
    "solid-js": "^1.9.13",
    "vite": "^7.3.5",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
